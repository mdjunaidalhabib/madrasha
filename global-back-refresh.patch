@@ -0,0 +1,47 @@
+import { useLocation, useNavigate } from "react-router-dom";
+import { ArrowLeft } from "lucide-react";
+import { useText } from "../i18n";
+import { navText } from "./nav.text";
+import { canGoBackInApp } from "./navHistory";
+
+type Props = {
+  /** The app's dashboard - used when there is no earlier in-app page. */
+  fallbackPath: string;
+  className?: string;
+};
+
+const stripTrailingSlash = (p: string) => (p.length > 1 ? p.replace(/\/+$/, "") : p);
+
+/**
+ * One Back button for the whole app. Goes to the previous router entry when it
+ * exists inside this app; otherwise (direct URL, bookmark, fresh PWA launch,
+ * previous page was a login screen) it replaces the current entry with the
+ * dashboard. Hidden only when already on the dashboard with nothing to go back to.
+ * A dirty form is protected by NavigationController's blocker.
+ */
+export default function GlobalBackButton({ fallbackPath, className = "" }: Props) {
+  const t = useText(navText);
+  const navigate = useNavigate();
+  const { pathname } = useLocation();
+
+  const hasHistory = canGoBackInApp();
+  const onFallback = stripTrailingSlash(pathname) === stripTrailingSlash(fallbackPath);
+  if (!hasHistory && onFallback) return null;
+
+  const handleClick = () => {
+    if (canGoBackInApp()) navigate(-1);
+    else navigate(fallbackPath, { replace: true });
+  };
+
+  return (
+    <button
+      type="button"
+      onClick={handleClick}
+      title={t.back}
+      aria-label={t.back}
+      className={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 active:scale-95 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 ${className}`}
+    >
+      <ArrowLeft size={18} className="rtl:rotate-180" />
+    </button>
+  );
+}
diff --git a/packages/shared-ui/src/navigation/GlobalRefreshButton.tsx b/packages/shared-ui/src/navigation/GlobalRefreshButton.tsx
new file mode 100644
index 0000000..d614f31
--- /dev/null
+++ b/packages/shared-ui/src/navigation/GlobalRefreshButton.tsx
@@ -0,0 +1,64 @@
+import { useRef } from "react";
+import { RefreshCw } from "lucide-react";
+import { useText } from "../i18n";
+import { navText } from "./nav.text";
+import { requestFullReload, requestRefresh, useRefreshStore } from "./refreshStore";
+
+const LONG_PRESS_MS = 700;
+
+/**
+ * One Refresh button for the whole app.
+ * Click = soft refresh (re-fetch current page data, session untouched).
+ * Shift+click or long-press = full page reload (the only option in an
+ * installed PWA, which has no browser reload button).
+ */
+export default function GlobalRefreshButton({ className = "" }: { className?: string }) {
+  const t = useText(navText);
+  const refreshing = useRefreshStore((s) => s.refreshing);
+  const pressTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const longPressed = useRef(false);
+
+  const clearTimer = () => {
+    if (pressTimer.current) clearTimeout(pressTimer.current);
+    pressTimer.current = null;
+  };
+
+  const onPointerDown = (e: React.PointerEvent) => {
+    longPressed.current = false;
+    if (e.pointerType === "mouse") return; // mouse users have Shift+click
+    clearTimer();
+    pressTimer.current = setTimeout(() => {
+      longPressed.current = true;
+      void requestFullReload();
+    }, LONG_PRESS_MS);
+  };
+
+  const onClick = (e: React.MouseEvent) => {
+    if (longPressed.current) {
+      longPressed.current = false;
+      return;
+    }
+    if (refreshing) return;
+    if (e.shiftKey) void requestFullReload();
+    else void requestRefresh();
+  };
+
+  return (
+    <button
+      type="button"
+      onClick={onClick}
+      onPointerDown={onPointerDown}
+      onPointerUp={clearTimer}
+      onPointerLeave={clearTimer}
+      onPointerCancel={clearTimer}
+      onContextMenu={(e) => e.preventDefault()}
+      disabled={refreshing}
+      aria-busy={refreshing}
+      aria-label={refreshing ? t.refreshing : t.refresh}
+      title={refreshing ? t.refreshing : `${t.refresh} — ${t.refreshHint}`}
+      className={`flex h-9 w-9 shrink-0 select-none items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 active:scale-95 disabled:cursor-wait disabled:opacity-70 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 ${className}`}
+    >
+      <RefreshCw size={17} className={refreshing ? "animate-spin" : ""} />
+    </button>
+  );
+}
diff --git a/packages/shared-ui/src/navigation/NavigationController.tsx b/packages/shared-ui/src/navigation/NavigationController.tsx
new file mode 100644
index 0000000..41cc745
--- /dev/null
+++ b/packages/shared-ui/src/navigation/NavigationController.tsx
@@ -0,0 +1,52 @@
+import { useEffect } from "react";
+import { useBlocker, useLocation } from "react-router-dom";
+import { recordLocation } from "./navHistory";
+import { confirmDiscardIfDirty, hasUnsavedChanges, shouldWarnOnUnload } from "./unsavedChanges";
+
+/**
+ * Mount ONCE inside each app's shell layout (it needs the router context).
+ *  1. Records the in-app navigation trail used by the global Back button.
+ *  2. Warns before browser close / F5 / Ctrl+R when a form has unsaved input
+ *     (a plain `beforeunload` listener - it never intercepts the shortcuts, so
+ *     Alt+Left, Ctrl+R and the browser's own buttons behave natively).
+ *  3. Warns before any in-app route change away from a dirty form (menu,
+ *     Back button, browser Back, Android system Back).
+ */
+export default function NavigationController() {
+  const location = useLocation();
+
+  useEffect(() => {
+    recordLocation(location.pathname + location.search);
+  }, [location.pathname, location.search]);
+
+  useEffect(() => {
+    const onBeforeUnload = (e: BeforeUnloadEvent) => {
+      if (!shouldWarnOnUnload()) return;
+      e.preventDefault();
+      e.returnValue = "";
+    };
+    window.addEventListener("beforeunload", onBeforeUnload);
+    return () => window.removeEventListener("beforeunload", onBeforeUnload);
+  }, []);
+
+  const blocker = useBlocker(
+    ({ currentLocation, nextLocation }) =>
+      hasUnsavedChanges() && currentLocation.pathname !== nextLocation.pathname,
+  );
+
+  useEffect(() => {
+    if (blocker.state !== "blocked") return;
+    let cancelled = false;
+    confirmDiscardIfDirty().then((ok) => {
+      if (cancelled) return;
+      if (ok) blocker.proceed();
+      else blocker.reset();
+    });
+    return () => {
+      cancelled = true;
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [blocker.state]);
+
+  return null;
+}
