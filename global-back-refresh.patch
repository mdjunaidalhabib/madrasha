+import type { ReactNode } from "react";
+import Breadcrumbs, { type BreadcrumbItem } from "../components/ui/Breadcrumbs";
+import GlobalBackButton from "./GlobalBackButton";
+import GlobalRefreshButton from "./GlobalRefreshButton";
+import NavigationController from "./NavigationController";
+
+type Props = {
+  breadcrumbs: BreadcrumbItem[];
+  /** Dashboard path of this app, used as Back's safe fallback. */
+  fallbackPath: string;
+  /** Extra content between the breadcrumbs and the refresh button (e.g. a date chip). */
+  trailing?: ReactNode;
+  /** Wrapper classes - layouts use this for sticky positioning / spacing. */
+  className?: string;
+};
+
+/**
+ * The shared "[Back] breadcrumbs ... [Refresh]" row used by every app shell
+ * (admin, super-admin, guardian portal). Renders on desktop, mobile browser and
+ * installed PWA alike, so there is exactly one implementation to maintain.
+ * Also mounts NavigationController (history trail + unsaved-changes guard).
+ */
+export default function PageNavBar({ breadcrumbs, fallbackPath, trailing, className = "" }: Props) {
+  return (
+    <div className={`mb-2 flex items-center gap-2 md:mb-4 ${className}`}>
+      <NavigationController />
+      <GlobalBackButton fallbackPath={fallbackPath} />
+      <div className="min-w-0 flex-1 [&>nav]:mb-0">
+        <Breadcrumbs items={breadcrumbs} />
+      </div>
+      {trailing}
+      <GlobalRefreshButton />
+    </div>
+  );
+}
