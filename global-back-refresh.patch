diff --git a/packages/shared-ui/src/navigation/navHistory.ts b/packages/shared-ui/src/navigation/navHistory.ts
new file mode 100644
index 0000000..5f37177
--- /dev/null
+++ b/packages/shared-ui/src/navigation/navHistory.ts
@@ -0,0 +1,68 @@
+/**
+ * In-app navigation trail, shared by every app (admin / frontend / super-admin).
+ *
+ * React Router (data router) stamps every history entry with a numeric `idx`
+ * in `window.history.state`. idx > 0 means there is an earlier entry that
+ * belongs to THIS app's session. We additionally remember which path each idx
+ * pointed at (sessionStorage - per tab/PWA window), so the Back button can
+ * refuse to "go back" into a login screen or other auth page and fall back to
+ * the dashboard instead.
+ *
+ * The browser's own Back / Alt+Left / Android system Back all just pop the same
+ * history stack, so the in-app Back button stays consistent with them.
+ */
+
+const TRAIL_KEY = "qms:nav-trail";
+
+type Trail = Record<string, string>;
+
+const AUTH_PATH = /(^|\/)(login|forgot-password|reset-password|change-password)(\/|\?|#|$)/;
+
+export const isAuthPath = (path: string) => AUTH_PATH.test(path);
+
+const readTrail = (): Trail => {
+  try {
+    return JSON.parse(sessionStorage.getItem(TRAIL_KEY) || "{}") as Trail;
+  } catch {
+    return {};
+  }
+};
+
+const writeTrail = (trail: Trail) => {
+  try {
+    sessionStorage.setItem(TRAIL_KEY, JSON.stringify(trail));
+  } catch {
+    /* storage unavailable (private mode / quota) - Back still works via idx */
+  }
+};
+
+export const currentHistoryIndex = (): number => {
+  const idx = (window.history.state as { idx?: unknown } | null)?.idx;
+  return typeof idx === "number" ? idx : 0;
+};
+
+/** Called on every location change. Entries after the current one are stale. */
+export function recordLocation(path: string) {
+  const idx = currentHistoryIndex();
+  const trail = readTrail();
+  trail[String(idx)] = path;
+  for (const key of Object.keys(trail)) {
+    if (Number(key) > idx) delete trail[key];
+  }
+  writeTrail(trail);
+}
+
+/** The path of the previous in-app entry, or null if there is none. */
+export function previousInAppPath(): string | null {
+  const idx = currentHistoryIndex();
+  if (idx <= 0) return null;
+  return readTrail()[String(idx - 1)] ?? null;
+}
+
+/** True when going back (-1) would stay inside the app and not hit an auth page. */
+export function canGoBackInApp(): boolean {
+  const prev = previousInAppPath();
+  // idx > 0 but unknown path (e.g. trail lost): trust the history stack.
+  if (prev === null) return currentHistoryIndex() > 0;
+  return !isAuthPath(prev);
+}
diff --git a/packages/shared-ui/src/navigation/refreshStore.ts b/packages/shared-ui/src/navigation/refreshStore.ts
new file mode 100644
index 0000000..e719a9f
--- /dev/null
+++ b/packages/shared-ui/src/navigation/refreshStore.ts
@@ -0,0 +1,131 @@
+import { create } from "zustand";
+import { useEffect, useRef } from "react";
+import { useToastStore } from "../store/toastStore";
+import { getText } from "../i18n";
+import { navText } from "./nav.text";
+import { confirmDiscardIfDirty, suppressUnloadWarningOnce } from "./unsavedChanges";
+
+/**
+ * Global refresh coordination.
+ *
+ * - `refreshKey` is mixed into the layout's route-outlet key, so a soft refresh
+ *   remounts the current page and every effect-based fetch on it runs again -
+ *   without a full browser reload (auth tokens / session in memory + storage stay).
+ * - App-level data (sidebar, plan, profile, caches...) registers a *global
+ *   refresher* with `useRegisterRefresher`. Its synchronous part runs first
+ *   (e.g. clearing a GET cache), so the remounted page doesn't read stale data.
+ * - A page that can refetch in place (keeping filters/scroll) may register
+ *   `usePageRefresh(fn)`; if any page handler exists it is used INSTEAD of the
+ *   remount.
+ * - Only one refresh runs at a time; extra clicks while it runs are ignored.
+ */
+type Refresher = () => unknown | Promise<unknown>;
+
+type RefreshState = { refreshKey: number; refreshing: boolean };
+
+export const useRefreshStore = create<RefreshState>(() => ({ refreshKey: 0, refreshing: false }));
+
+const globalRefreshers = new Set<Refresher>();
+const pageRefreshers = new Set<Refresher>();
+
+export const registerRefresher = (fn: Refresher) => {
+  globalRefreshers.add(fn);
+  return () => {
+    globalRefreshers.delete(fn);
+  };
+};
+
+const registerPageRefresher = (fn: Refresher) => {
+  pageRefreshers.add(fn);
+  return () => {
+    pageRefreshers.delete(fn);
+  };
+};
+
+/** App-level data refresh (call from the layout). `fn` may change every render. */
+export function useRegisterRefresher(fn: Refresher) {
+  const ref = useRef(fn);
+  ref.current = fn;
+  useEffect(() => registerRefresher(() => ref.current()), []);
+}
+
+/** Page-level in-place refetch (optional). Replaces the remount while mounted. */
+export function usePageRefresh(fn: Refresher) {
+  const ref = useRef(fn);
+  ref.current = fn;
+  useEffect(() => registerPageRefresher(() => ref.current()), []);
+}
+
+const MIN_SPINNER_MS = 600;
+let inFlight: Promise<boolean> | null = null;
+
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+async function runSoftRefresh(): Promise<boolean> {
+  const startedAt = Date.now();
+  useRefreshStore.setState({ refreshing: true });
+  let ok = true;
+  try {
+    // 1) App-level refreshers: sync part (cache clearing) runs right now.
+    const globalRuns = [...globalRefreshers].map((fn) => {
+      try {
+        return Promise.resolve(fn());
+      } catch (err) {
+        return Promise.reject(err);
+      }
+    });
+
+    // 2) Current page: in-place handlers if any, otherwise remount via key.
+    let pageRuns: Promise<unknown>[] = [];
+    if (pageRefreshers.size > 0) {
+      pageRuns = [...pageRefreshers].map((fn) => {
+        try {
+          return Promise.resolve(fn());
+        } catch (err) {
+          return Promise.reject(err);
+        }
+      });
+    } else {
+      useRefreshStore.setState((s) => ({ refreshKey: s.refreshKey + 1 }));
+    }
+
+    const results = await Promise.allSettled([...globalRuns, ...pageRuns]);
+    ok = results.every((r) => r.status === "fulfilled");
+  } finally {
+    const elapsed = Date.now() - startedAt;
+    if (elapsed < MIN_SPINNER_MS) await sleep(MIN_SPINNER_MS - elapsed);
+    useRefreshStore.setState({ refreshing: false });
+  }
+  return ok;
+}
+
+/** Soft refresh. Safe to call repeatedly: duplicates join the running one. */
+export async function requestRefresh(): Promise<boolean> {
+  const t = getText(navText);
+  if (inFlight) return inFlight;
+
+  if (typeof navigator !== "undefined" && navigator.onLine === false) {
+    useToastStore.getState().show(t.offline, "error");
+    return false;
+  }
+  if (!(await confirmDiscardIfDirty())) return false;
+  if (inFlight) return inFlight; // another click won the race while the dialog was open
+
+  inFlight = runSoftRefresh()
+    .then((ok) => {
+      if (!ok) useToastStore.getState().show(t.refreshFailed, "error");
+      return ok;
+    })
+    .finally(() => {
+      inFlight = null;
+    });
+  return inFlight;
+}
+
+/** Full browser reload - session survives because tokens live in storage/cookies. */
+export async function requestFullReload(): Promise<void> {
+  if (inFlight) return;
+  if (!(await confirmDiscardIfDirty())) return;
+  suppressUnloadWarningOnce(); // we already asked; don't show the native prompt too
+  window.location.reload();
+}
diff --git a/packages/shared-ui/src/navigation/unsavedChanges.ts b/packages/shared-ui/src/navigation/unsavedChanges.ts
new file mode 100644
index 0000000..e745ddd
--- /dev/null
+++ b/packages/shared-ui/src/navigation/unsavedChanges.ts
@@ -0,0 +1,51 @@
+import { useEffect, useRef } from "react";
+import { useConfirmStore } from "../store/confirmStore";
+import { getText } from "../i18n";
+import { navText } from "./nav.text";
+
+/**
+ * Registry of "this screen has unsaved input" flags.
+ *
+ * A form page calls `useUnsavedChangesGuard(isDirty)`. While any registered
+ * source is dirty, NavigationController warns on browser close/reload and on
+ * in-app navigation (menu, Back button, browser/Android Back), and the global
+ * Refresh button asks first. Unmounting a form clears its flag automatically.
+ */
+const dirtySources = new Set<symbol>();
+let skipUnloadWarning = false;
+
+export const hasUnsavedChanges = () => dirtySources.size > 0;
+
+export const suppressUnloadWarningOnce = () => {
+  skipUnloadWarning = true;
+};
+
+export const shouldWarnOnUnload = () => hasUnsavedChanges() && !skipUnloadWarning;
+
+export function useUnsavedChangesGuard(isDirty: boolean) {
+  const id = useRef<symbol>(Symbol("unsaved-changes"));
+  useEffect(() => {
+    const source = id.current;
+    if (isDirty) dirtySources.add(source);
+    else dirtySources.delete(source);
+    return () => {
+      dirtySources.delete(source);
+    };
+  }, [isDirty]);
+}
+
+/** Resolves true if there is nothing unsaved or the user chose to discard it. */
+export function confirmDiscardIfDirty(): Promise<boolean> {
+  if (!hasUnsavedChanges()) return Promise.resolve(true);
+  const t = getText(navText);
+  return new Promise<boolean>((resolve) => {
+    useConfirmStore.getState().show({
+      title: t.unsavedTitle,
+      message: t.unsavedMessage,
+      confirmText: t.leaveAnyway,
+      danger: true,
+      onConfirm: () => resolve(true),
+      onCancel: () => resolve(false),
+    });
+  });
+}
