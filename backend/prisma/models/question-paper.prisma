model QuestionPaper {
  id           String   @id @default(uuid()) @db.Uuid
  madrasaId    Int      @map("madrasa_id")
  createdBy    Int?     @map("created_by")
  title        String   @db.VarChar(200)
  divisionId   Int      @map("division_id")
  classId      Int      @map("class_id")
  subjectId    Int      @map("subject_id")
  divisionName String   @map("division_name") @db.VarChar(150)
  className    String   @map("class_name") @db.VarChar(150)
  subject      String   @db.VarChar(200)
  duration     String   @default("") @db.VarChar(100)
  instructions String   @default("")
  layout       Json     @default("{}")
  questions    Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  madrasa      Madrasa  @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@index([madrasaId, updatedAt], map: "idx_question_papers_tenant_updated")
  @@map("question_papers")
}

model QuestionPaperClosingTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  madrasaId Int      @map("madrasa_id")
  kind      String   @default("closing") @db.VarChar(20)
  text      String   @db.VarChar(500)
  builtinKey String? @map("builtin_key") @db.VarChar(30)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  madrasa   Madrasa  @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@unique([madrasaId, kind, text])
  @@unique([madrasaId, kind, builtinKey])
  @@map("question_paper_closing_templates")
}
