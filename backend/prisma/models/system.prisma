// ============================================================
// SYSTEM — Platform-level catalog
// Not tenant-scoped: super admin accounts, subscription plans, and the
// module/feature/permission catalog that tenants activate from.
// ============================================================

model SuperAdmin {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(150)
  email        String    @unique @db.VarChar(200)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Int?      @default(1) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("super_admins")
}

/// Platform-wide (not per-tenant) Cloudinary account, used for Super
/// Admin's own uploads (System Template backgrounds) - the same shape and
/// encryption approach as MadrasaCloudinaryConfig, just without a
/// madrasaId since there's exactly one row for the whole platform.
/// Configured from the Super Admin Settings page, not backend/.env.
model PlatformCloudinaryConfig {
  id           Int      @id @default(autoincrement())
  cloudName    String   @map("cloud_name") @db.VarChar(100)
  apiKey       String   @map("api_key") @db.VarChar(100)
  apiSecretEnc String   @map("api_secret_enc") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_cloudinary_configs")
}

/// Platform-wide (not per-tenant) SMS gateway account used to send SMS
/// notifications for every madrasa - configured from Super Admin Settings,
/// replacing the old SMS_* env vars. Kept generic (configurable URL/param
/// names, both for sending and for balance-check) because Bangladeshi SMS
/// gateways (SSLWireless, Alpha SMS, BulkSMSBD, ...) all expose a simple
/// HTTP GET/POST but disagree on param names and balance-check shape, and
/// the actual gateway to use hasn't been decided yet.
model PlatformSmsConfig {
  id                  Int      @id @default(autoincrement())
  /// Free-text label only (e.g. "BulkSMSBD") - not read by the send logic.
  provider            String?  @db.VarChar(100)
  apiUrl              String   @map("api_url") @db.VarChar(300)
  apiKeyEnc           String   @map("api_key_enc") @db.Text
  senderId            String?  @map("sender_id") @db.VarChar(50)
  /// "GET" or "POST" - which HTTP method the send endpoint expects.
  httpMethod          String   @default("GET") @map("http_method") @db.VarChar(10)
  paramApiKey         String   @default("api_key") @map("param_api_key") @db.VarChar(50)
  paramSenderId       String   @default("senderid") @map("param_sender_id") @db.VarChar(50)
  paramNumber         String   @default("number") @map("param_number") @db.VarChar(50)
  paramMessage        String   @default("message") @map("param_message") @db.VarChar(50)
  /// Balance-check endpoint - optional; balance check is reported as
  /// unavailable (not guessed) when this is unset.
  balanceUrl          String?  @map("balance_url") @db.VarChar(300)
  balanceHttpMethod   String   @default("GET") @map("balance_http_method") @db.VarChar(10)
  balanceParamApiKey  String   @default("api_key") @map("balance_param_api_key") @db.VarChar(50)
  /// Dot-path into the balance endpoint's JSON response to the numeric
  /// balance field, e.g. "balance" or "data.balance".
  balanceResponsePath String   @default("balance") @map("balance_response_path") @db.VarChar(100)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_sms_configs")
}

/// Platform-wide SMTP account used to send Email notifications for every
/// madrasa - configured from Super Admin Settings, replacing the old
/// SMTP_* env vars. SMTP has no "balance" concept, so the Settings page
/// offers a connection test (transporter.verify()) instead.
model PlatformEmailConfig {
  id        Int      @id @default(autoincrement())
  host      String   @db.VarChar(200)
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String   @db.VarChar(200)
  passEnc   String   @map("pass_enc") @db.Text
  fromName  String   @default("Madrasa Management") @map("from_name") @db.VarChar(150)
  fromEmail String   @map("from_email") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_email_configs")
}

model Plan {
  id           Int       @id @default(autoincrement())
  name         String    @unique(map: "uniq_plan_name") @db.VarChar(100)
  studentLimit Int       @map("student_limit")
  userLimit    Int       @map("user_limit")
  durationDays Int?      @default(365) @map("duration_days")
  price        Decimal?  @default(0) @db.Decimal(10, 2)
  isActive     Int?      @default(1) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  subscriptions MadrasaSubscription[]

  @@map("plans")
}

model ModuleDef {
  id        Int      @id @default(autoincrement())
  keyName   String?  @unique @map("key_name") @db.VarChar(50)
  name      String?  @db.VarChar(100)
  nameBn    String?  @map("name_bn") @db.VarChar(100)
  groupName String?  @map("group_name") @db.VarChar(100)
  sortOrder Int?     @default(0) @map("sort_order")
  isActive  Int?     @default(1) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  features       ModuleFeature[]
  madrasaModules MadrasaModule[]

  @@map("modules")
}

model ModuleFeature {
  id        Int      @id @default(autoincrement())
  moduleId  Int?     @map("module_id")
  keyName   String?  @map("key_name") @db.VarChar(100)
  name      String?  @db.VarChar(150)
  nameBn    String?  @map("name_bn") @db.VarChar(150)
  sortOrder Int?     @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  module ModuleDef? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, keyName], map: "uniq_feature")
  @@map("module_features")
}

model Permission {
  id        Int      @id @default(autoincrement())
  keyName   String?  @unique @map("key_name") @db.VarChar(100)
  name      String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

// ============================================================
// MADRASA PROVISIONING TEMPLATES
// Seeded platform-level demo/default rows. These are never tenant data.
// When Super Admin creates a madrasa, active rows are copied into that
// madrasa so editing seed.ts only affects madrasas created afterwards.
// ============================================================

model DefaultExam {
  id        Int      @id @default(autoincrement())
  keyName   String   @unique @map("key_name") @db.VarChar(80)
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("default_exams")
}

model DefaultGeneralGrade {
  id        Int      @id @default(autoincrement())
  keyName   String   @unique @map("key_name") @db.VarChar(80)
  name      String   @db.VarChar(10)
  minMark   Int      @map("min_mark")
  maxMark   Int      @map("max_mark")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("default_general_grades")
}

model DefaultMadrasaGrade {
  id        Int      @id @default(autoincrement())
  keyName   String   @unique @map("key_name") @db.VarChar(80)
  name      String   @db.VarChar(50)
  minMark   Int      @map("min_mark")
  maxMark   Int      @map("max_mark")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("default_madrasa_grades")
}

model DefaultSetting {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  value     String?  @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("default_settings")
}

/// Global "গুরুত্বপূর্ণ লিংক" (important links) shown on every tenant's
/// Dashboard - managed centrally by Super Admin (add/edit/delete/reorder),
/// same shared-catalog shape as the Default* templates above but read
/// directly (not copied) since every tenant should always see the latest
/// list, not a point-in-time snapshot.
model ImportantLink {
  id        Int      @id @default(autoincrement())
  label     String   @db.VarChar(150)
  subLabel  String?  @map("sub_label") @db.VarChar(150)
  url       String   @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("important_links")
}

/// Global fee-structure template, managed by Super Admin (unlike the other
/// Default* templates above, this one also gets a full CRUD UI - see
/// meta.* vs default-fee-structure.* modules). Active rows are copied into
/// a new madrasa's own FeeStructure rows at creation time (same "snapshot
/// once, never touched again" rule as the templates above), not kept in
/// sync afterward - editing this later only affects future madrasas.
model DefaultFeeStructure {
  id        Int          @id @default(autoincrement())
  keyName   String       @unique @map("key_name") @db.VarChar(80)
  /// null = applies to every class, matching FeeStructure.classId semantics.
  classId   Int?         @map("class_id")
  name      String       @db.VarChar(150)
  amount    Decimal      @db.Decimal(10, 2)
  frequency FeeFrequency
  feeType   FeeType      @default(OTHER) @map("fee_type")
  sortOrder Int          @default(0) @map("sort_order")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  class Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@map("default_fee_structures")
}
