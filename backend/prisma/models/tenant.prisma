// ============================================================
// TENANT — Madrasa account, billing, RBAC, users, settings,
// and the tenant's public marketing website.
// ============================================================

enum WebsiteStatus {
  active
  limited
  disabled
}

enum WebsiteAdmissionStatus {
  pending
  approved
  rejected
}

enum PlanStatus {
  trial
  active
  expired
  suspended
}

enum PaymentStatus {
  pending
  paid
  failed
}

model Madrasa {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(200)
  slug          String        @unique @db.VarChar(120)
  phone         String?       @db.VarChar(20)
  email         String?       @db.VarChar(120)
  address       String?       @db.VarChar(255)
  studentLimit  Int?          @default(100) @map("student_limit")
  userLimit     Int?          @default(5) @map("user_limit")
  websiteStatus WebsiteStatus @default(active) @map("website_status")
  customDomain  String?       @unique @map("custom_domain") @db.VarChar(190)
  planStatus    PlanStatus    @default(active) @map("plan_status")
  isActive      Int?          @default(1) @map("is_active")
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  reportLogo             String? @map("report_logo")
  reportBanner           String? @map("report_banner")
  reportWatermark        String? @map("report_watermark")
  reportWatermarkOpacity Decimal @default(0.08) @map("report_watermark_opacity") @db.Decimal(3, 2)

  // Institution contact numbers/emails shown on branded documents (distinct
  // from `phone`/`email` above, which are the tenant account's own single
  // contact info) - a madrasa commonly lists more than one number.
  brandingPhones String[] @default([]) @map("branding_phones")
  brandingEmails String[] @default([]) @map("branding_emails")

  // Custom report header/footer IMAGE, shown on every printed report/document
  // INSTEAD of the default logo+name+address header when enabled - not text,
  // so a madrasa can print its own pre-designed letterhead artwork at full
  // upload quality (same untouched Cloudinary storage as reportLogo/
  // reportBanner/reportWatermark - no server-side resize/compression).
  // Enabling this hides the default header/footer entirely, even before an
  // image is uploaded (the space simply renders blank until one is set).
  // printMode "letterhead" suppresses the logo/background/watermark/header/
  // footer entirely at print time (pre-printed press paper already has
  // them) - "normal" prints them as configured.
  reportHeaderFooterEnabled Int?    @default(0) @map("report_header_footer_enabled")
  // Superseded by reportHeaderImage/reportFooterImage below (custom header/
  // footer is now an uploaded image, not typed text) - columns kept so any
  // madrasa that already set text before this change doesn't silently lose
  // it, but no code reads/writes these two anymore.
  reportHeaderText          String? @map("report_header_text") @db.Text
  reportFooterText          String? @map("report_footer_text") @db.Text
  reportHeaderImage         String? @map("report_header_image")
  reportFooterImage         String? @map("report_footer_image")
  reportPrintMode           String? @default("normal") @map("report_print_mode") @db.VarChar(20)

  // Fine-grained layout control for the DEFAULT logo+name+address header and
  // the (new) default text footer - font sizes, colors, logo size/position,
  // and how much page space the header/footer band reserves. Only applies
  // when reportHeaderFooterEnabled is off (the custom header/footer IMAGE
  // path above is unaffected and keeps its own fixed HEADER_BAND_MM/
  // FOOTER_BAND_MM bands). A single JSON blob (see BrandLayoutData in
  // settings.types.ts for the shape/defaults) instead of one column per
  // knob, since this list only grows and every field is optional/sparse.
  reportBrandLayout Json? @map("report_brand_layout")

  // Marksheet info-field visibility + display order (roll/registration_no/
  // date_of_birth/student_name/father_name/madrasa_grade/general_grade/
  // status/rank_no) - a JSON array of { key, visible } in display order (see
  // MarksheetFieldItem in settings.types.ts). Array order IS the render
  // order, so reordering is just moving an entry, not a separate position
  // field. Null/missing = every known field visible in MarksheetList.tsx's
  // original hardcoded order.
  marksheetFieldLayout Json? @map("marksheet_field_layout")

  // Per-section enabled/disabled state for the admin settings pages
  // (ProfileSettingsPage/BrandingSettingsPage's SectionCards) - a single
  // JSON map { sectionKey: boolean } instead of one column per section, since
  // this list only grows. A missing key defaults to enabled (true).
  settingsSectionToggles Json? @map("settings_section_toggles")

  // Master kill-switch for the SMS/ইমেইল module's অটো নোটিফিকেশন page (see
  // AutoNotificationSettingsPage.tsx). Turning this off pauses every
  // per-event NotificationSetting.isEnabled row WITHOUT changing any of
  // them - notification.service.ts#triggerEvent checks this first and
  // short-circuits, so flipping it back on resumes sending exactly per each
  // event's own already-configured state instead of forcing everything back
  // on.
  autoNotificationsEnabled Int @default(1) @map("auto_notifications_enabled")

  sanadTemplate          String? @map("sanad_template") @db.Text
  testimonialTemplate    String? @map("testimonial_template") @db.Text
  transferLetterTemplate String? @map("transfer_letter_template") @db.Text
  admitCardRules         String? @map("admit_card_rules") @db.Text
  customNoticeTemplate   String? @map("custom_notice_template") @db.Text

  idCardDesign          String? @map("id_card_design") @db.VarChar(20)
  idCardBackgroundImage String? @map("id_card_background_image") @db.Text

  admitCardDesign          String? @map("admit_card_design") @db.VarChar(20)
  admitCardBackgroundImage String? @map("admit_card_background_image") @db.Text
  letterDesign             String? @map("letter_design") @db.VarChar(20)
  letterBackgroundImage    String? @map("letter_background_image") @db.Text

  bookLabelDesign          String? @map("book_label_design") @db.VarChar(20)
  bookLabelBackgroundImage String? @map("book_label_background_image") @db.Text

  subscriptions                MadrasaSubscription[]
  subscriptionPayments         SubscriptionPayment[]
  madrasaDivisions             MadrasaDivision[]
  madrasaClasses               MadrasaClass[]
  madrasaBooks                 MadrasaBook[]
  madrasaModules               MadrasaModule[]
  roles                        Role[]
  users                        User[]
  students                     Student[]
  teachers                     Teacher[]
  teacherAssignments           TeacherAssignment[]
  staff                        Staff[]
  accounts                     Account[]
  accountFunds                 AccountFund[]
  exams                        Exam[]
  generalGrades                GeneralGrade[]
  madrasaGrades                MadrasaGrade[]
  settings                     Setting[]
  resultsMaster                ResultMaster[]
  activityLogs                 ActivityLog[]
  websiteSettings              WebsiteSettings?
  websitePages                 WebsitePage[]
  websiteNotices               WebsiteNotice[]
  websiteGallery               WebsiteGallery[]
  websiteSlides                WebsiteSlide[]
  websiteCommitteeMembers      WebsiteCommitteeMember[]
  websiteAdmissionApplications WebsiteAdmissionApplication[]
  attendances                  Attendance[]
  classRoutines                ClassRoutine[]
  examRoutines                 ExamRoutine[]
  promotionBatches             PromotionBatch[]
  sessions                     Session[]
  studentSessionHistories      StudentSessionHistory[]
  feeStructures                FeeStructure[]
  feeCategories                FeeCategory[]
  invoices                     Invoice[]
  studentFeeDiscounts          StudentFeeDiscount[]
  examCandidates               ExamCandidate[]
  examRooms                    ExamRoom[]
  examInvigilatorAssignments   ExamInvigilatorAssignment[]
  seatAllocations              SeatAllocation[]
  examAttendances              ExamAttendance[]
  markSubmissions              MarkSubmission[]
  markComponentConfigs         MarkComponentConfig[]
  resultCorrections            ResultCorrection[]
  resultSnapshots              ResultSnapshot[]
  payments                     Payment[]
  paymentMethodSettings        PaymentMethodSetting[]
  payrollRecords               PayrollRecord[]
  passwordResetTokens          PasswordResetToken[]
  refreshTokens                RefreshToken[]
  notificationLogs             NotificationLog[]
  notificationSettings         NotificationSetting[]
  guardians                    Guardian[]
  documentTemplates            DocumentTemplate[]
  tenantDocumentDefaults       TenantDocumentDefault[]
  printableNotices             PrintableNotice[]
  kioskDevices                 KioskDevice[]
  attendanceDevices            AttendanceDevice[]
  attendanceDeviceUserMaps     AttendanceDeviceUserMap[]
  attendanceDeviceLogs         AttendanceDeviceLog[]
  smsQueue                     SmsQueue[]
  libraryBookCategories        LibraryBookCategory[]
  libraryBooks                 LibraryBook[]
  libraryBorrowRecords         LibraryBorrowRecord[]
  messageSubscriptions         MessageSubscription[]
  messageUsageLogs             MessageUsageLog[]
  billingTransactions          BillingTransaction[]
  messagePricingOverrides      MadrasaMessagePricing[]
  messagePurchaseRequests      MessagePurchaseRequest[]

  @@index([isActive, deletedAt], map: "idx_madrasas_active")
  @@index([planStatus], map: "idx_madrasas_plan_status")
  @@map("madrasas")
}

model MadrasaSubscription {
  id        Int       @id @default(autoincrement())
  madrasaId Int       @map("madrasa_id")
  planId    Int       @map("plan_id")
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  isActive  Int?      @default(1) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  madrasa  Madrasa               @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments SubscriptionPayment[]

  @@index([madrasaId, isActive], map: "idx_subscription_madrasa_active")
  @@map("madrasa_subscriptions")
}

model SubscriptionPayment {
  id             Int            @id @default(autoincrement())
  madrasaId      Int?           @map("madrasa_id")
  subscriptionId Int?           @map("subscription_id")
  amount         Decimal?       @db.Decimal(10, 2)
  paymentMethod  String?        @map("payment_method") @db.VarChar(50)
  transactionId  String?        @map("transaction_id") @db.VarChar(100)
  status         PaymentStatus? @default(pending)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  // SetNull (not Cascade): payment/billing history is platform-level audit
  // data and should survive even if the tenant or subscription is later
  // removed.
  madrasa      Madrasa?             @relation(fields: [madrasaId], references: [id], onDelete: SetNull)
  subscription MadrasaSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([madrasaId], map: "idx_subscription_payments_madrasa")
  @@index([subscriptionId], map: "idx_subscription_payments_subscription")
  @@index([status], map: "idx_subscription_payments_status")
  @@map("subscription_payments")
}

model MadrasaModule {
  id        Int      @id @default(autoincrement())
  madrasaId Int      @map("madrasa_id")
  moduleId  Int      @map("module_id")
  isActive  Int?     @default(1) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa   @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  module  ModuleDef @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([madrasaId, moduleId], map: "uniq_madrasa_module")
  @@map("madrasa_modules")
}

model Role {
  id        Int      @id @default(autoincrement())
  madrasaId Int?     @map("madrasa_id")
  keyName   String?  @map("key_name") @db.VarChar(50)
  nameBn    String?  @map("name_bn") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa         Madrasa?         @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  users           User[]

  // NOTE: this unique constraint did not exist before (the old schema let
  // duplicate role key_names be created for the same tenant). Since there
  // is no production data yet, it's added here as a real gap-fix rather
  // than carried forward. Safe: it's a new constraint, not a field/type
  // change, so it does not affect existing backend code.
  @@unique([madrasaId, keyName], map: "uniq_role_madrasa_key")
  @@index([madrasaId], map: "idx_roles_madrasa")
  @@map("roles")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  Int       @id @default(autoincrement())
  madrasaId           Int       @map("madrasa_id")
  name                String    @db.VarChar(200)
  email               String    @db.VarChar(200)
  mobile              String?   @db.VarChar(20)
  photoUrl            String?   @map("photo_url") @db.VarChar(500)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  roleId              Int       @map("role_id")
  isActive            Int?      @default(1) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at")
  /// Consecutive failed login attempts since the last successful login
  /// (or since the lock last expired). Reset to 0 on any successful
  /// login. Paired with `lockedUntil` for a simple account-lockout.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Set once failedLoginAttempts crosses the threshold; login is
  /// rejected (even with the correct password) until this time passes.
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  madrasa             Madrasa              @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  role                Role                 @relation(fields: [roleId], references: [id])
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]

  @@unique([madrasaId, email], map: "uniq_email_madrasa")
  @@index([madrasaId], map: "idx_users_madrasa")
  @@index([roleId], map: "idx_users_role")
  @@index([madrasaId, isActive], map: "idx_users_madrasa_active")
  @@map("users")
}

/// A one-time, short-lived token issued for a "forgot password" request.
/// Only the SHA-256 hash of the raw token is stored (mirrors how
/// passwordHash never stores the plaintext password) so a leaked database
/// row alone can't be used to reset an account.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  madrasaId Int       @map("madrasa_id")
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(100)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_user")
  @@index([expiresAt], map: "idx_password_reset_expires")
  @@map("password_reset_tokens")
}

/// A DB-backed refresh token issued alongside a short-lived access token
/// (see JWT_EXPIRES_IN) so a session can be revoked server-side ("logout
/// from all devices") instead of just expiring passively. Only the SHA-256
/// hash of the raw token is stored, same reasoning as PasswordResetToken.
model RefreshToken {
  id         Int       @id @default(autoincrement())
  madrasaId  Int       @map("madrasa_id")
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(100)
  /// Optional device/browser label, shown in an "active sessions" list later.
  deviceInfo String?   @map("device_info") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_token_user")
  @@index([expiresAt], map: "idx_refresh_token_expires")
  @@map("refresh_tokens")
}

model Setting {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  value     String?  @db.VarChar(50)
  madrasaId Int      @default(1) @map("madrasa_id")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@unique([madrasaId, name], map: "uniq_setting_madrasa")
  @@map("settings")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  madrasaId Int?     @map("madrasa_id")
  userId    Int?     @map("user_id")
  action    String?  @db.VarChar(100)
  entity    String?  @db.VarChar(100)
  entityId  Int?     @map("entity_id")
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // NOTE: no relation on userId on purpose (kept identical to the original
  // schema) — a log entry must survive even after the acting user is
  // deleted. The backend already relies on this via a raw SQL join.
  madrasa Madrasa? @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@index([madrasaId, createdAt], map: "idx_activity_madrasa_created")
  @@index([userId], map: "idx_activity_user")
  @@map("activity_logs")
}

// ------------------------------------------------------------
// PUBLIC WEBSITE (per-tenant marketing site / CMS)
// ------------------------------------------------------------

model WebsiteSettings {
  id             Int     @id @default(autoincrement())
  madrasaId      Int     @unique @map("madrasa_id")
  logoUrl        String? @map("logo_url") @db.VarChar(255)
  heroTitle      String? @map("hero_title") @db.VarChar(190)
  heroSubtitle   String? @map("hero_subtitle") @db.Text
  themeColor     String? @default("#2563eb") @map("theme_color") @db.VarChar(30)
  showNotices    Int?    @default(1) @map("show_notices")
  showGallery    Int?    @default(1) @map("show_gallery")
  showTeachers   Int?    @default(1) @map("show_teachers")
  showAdmission  Int?    @default(1) @map("show_admission")
  showAbout      Int?    @default(1) @map("show_about")
  showContact    Int?    @default(1) @map("show_contact")
  showSlider     Int?    @default(1) @map("show_slider")
  showMuhtamim   Int?    @default(1) @map("show_muhtamim")
  showCommittee  Int?    @default(1) @map("show_committee")
  showNoticeBar  Int?    @default(1) @map("show_notice_bar")
  isPublished    Int?    @default(1) @map("is_published")
  noticeBarText  String? @map("notice_bar_text") @db.Text
  noticeBarSpeed Int?    @default(20) @map("notice_bar_speed")

  muhtamimName        String? @map("muhtamim_name") @db.VarChar(190)
  muhtamimDesignation String? @map("muhtamim_designation") @db.VarChar(190)
  muhtamimPhoto       String? @map("muhtamim_photo") @db.VarChar(255)
  muhtamimMessage     String? @map("muhtamim_message") @db.Text

  facebookUrl        String? @map("facebook_url") @db.VarChar(255)
  youtubeUrl         String? @map("youtube_url") @db.VarChar(255)
  instagramUrl       String? @map("instagram_url") @db.VarChar(255)
  whatsappChannelUrl String? @map("whatsapp_channel_url") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@map("website_settings")
}

model WebsitePage {
  id          Int      @id @default(autoincrement())
  madrasaId   Int      @map("madrasa_id")
  pageKey     String   @map("page_key") @db.VarChar(60)
  title       String   @db.VarChar(190)
  content     String?
  isPublished Int?     @default(1) @map("is_published")
  sortOrder   Int?     @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@unique([madrasaId, pageKey], map: "uniq_website_page")
  @@map("website_pages")
}

model WebsiteNotice {
  id          Int       @id @default(autoincrement())
  madrasaId   Int       @map("madrasa_id")
  title       String    @db.VarChar(190)
  content     String?   @db.Text
  isPublished Int?      @default(1) @map("is_published")
  publishedAt DateTime? @default(now()) @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@index([madrasaId, isPublished, publishedAt], map: "idx_website_notices_madrasa")
  @@map("website_notices")
}

// Ad-hoc printable notices ("দেয়ালে টানানোর নোটিশ") staff write from
// Talimat > সেটিং > নোটিশ বোর্ড, then print on the madrasa's letterhead to
// post physically on the notice board. Unlike WebsiteNotice (published to
// the public website), these are never shown on the website - purely an
// internal, printable document list, so a madrasa can keep any number of
// them around (exam notice, holiday notice, admission notice, ...) and
// reprint any one of them later instead of overwriting a single template.
model PrintableNotice {
  id        Int      @id @default(autoincrement())
  madrasaId Int      @map("madrasa_id")
  title     String   @db.VarChar(190)
  body      String   @db.Text
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@index([madrasaId, updatedAt], map: "idx_printable_notices_madrasa")
  @@map("printable_notices")
}

model WebsiteGallery {
  id          Int      @id @default(autoincrement())
  madrasaId   Int      @map("madrasa_id")
  title       String?  @db.VarChar(190)
  imageUrl    String   @map("image_url") @db.VarChar(255)
  isPublished Int?     @default(1) @map("is_published")
  sortOrder   Int?     @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@index([madrasaId, isPublished, sortOrder], map: "idx_website_gallery_madrasa")
  @@map("website_gallery")
}

/// Homepage hero slider images (distinct from the WebsiteGallery photo grid) —
/// each slide can carry its own caption + CTA button.
model WebsiteSlide {
  id          Int      @id @default(autoincrement())
  madrasaId   Int      @map("madrasa_id")
  title       String?  @db.VarChar(190)
  subtitle    String?  @db.VarChar(255)
  imageUrl    String   @map("image_url") @db.VarChar(255)
  buttonText  String?  @map("button_text") @db.VarChar(60)
  buttonLink  String?  @map("button_link") @db.VarChar(255)
  isPublished Int?     @default(1) @map("is_published")
  sortOrder   Int?     @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@index([madrasaId, isPublished, sortOrder], map: "idx_website_slides_madrasa")
  @@map("website_slides")
}

model WebsiteCommitteeMember {
  id          Int      @id @default(autoincrement())
  madrasaId   Int      @map("madrasa_id")
  name        String   @db.VarChar(190)
  designation String?  @db.VarChar(190)
  photoUrl    String?  @map("photo_url") @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  isPublished Int?     @default(1) @map("is_published")
  sortOrder   Int?     @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@index([madrasaId, isPublished, sortOrder], map: "idx_website_committee_madrasa")
  @@map("website_committee_members")
}

/// Public "online admission" form submissions from the marketing website.
/// Reviewed manually by the madrasa admin (status pending/approved/rejected);
/// approval does not auto-create a Student record.
model WebsiteAdmissionApplication {
  id            Int                    @id @default(autoincrement())
  madrasaId     Int                    @map("madrasa_id")
  studentName   String                 @map("student_name") @db.VarChar(190)
  fatherName    String?                @map("father_name") @db.VarChar(190)
  motherName    String?                @map("mother_name") @db.VarChar(190)
  gender        String?                @db.VarChar(10)
  dateOfBirth   DateTime?              @map("date_of_birth") @db.Date
  classApplied  String?                @map("class_applied") @db.VarChar(100)
  guardianPhone String?                @map("guardian_phone") @db.VarChar(20)
  address       String?                @db.Text
  note          String?                @db.Text
  status        WebsiteAdmissionStatus @default(pending)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@index([madrasaId, status, createdAt], map: "idx_website_admission_madrasa")
  @@map("website_admission_applications")
}
