// ============================================================
// STUDENTS
// ============================================================

/// Admission workflow status. Students created directly by an admin are
/// APPROVED immediately (unchanged existing behavior); PENDING is used by
/// online/public admission requests that need admin review before the
/// student becomes an active, rolled student.
enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Whether this admission was a brand new student or a returning student
/// re-admitted into a new session. Set automatically by the server from the
/// NID-lookup result at submission time - never a manual client input.
enum AdmissionType {
  NEW
  RE_ADMISSION
}

model Student {
  id        Int @id @default(autoincrement())
  madrasaId Int @map("madrasa_id")

  divisionId          Int     @map("division_id")
  classId             Int     @map("class_id")
  /// Mirrored display string derived from `sessionRef.name` - not
  /// authoritative once `sessionId` is set. Kept for backward compatibility
  /// with existing reports/filters/indexes.
  academicYear        String  @default("2025") @map("academic_year") @db.VarChar(10)
  sessionId           Int     @map("session_id")
  previousClassId     Int?    @map("previous_class_id")
  previousInstitution String? @map("previous_institution") @db.VarChar(200)
  previousResult      String? @map("previous_result") @db.VarChar(100)

  nameBn     String  @map("name_bn") @db.VarChar(200)
  arabicName String? @map("arabic_name") @db.VarChar(200)

  nid String? @db.VarChar(50)

  /// 1 = Male, 2 = Female
  gender Int?

  dob DateTime? @db.Date
  age Int?

  bloodGroup String? @map("blood_group") @db.VarChar(5)

  /// 1 = আবাসিক (residential), 2 = অনাবাসিক (non-residential)
  residencyType Int? @map("residency_type")

  /// 1 = yes, 0/null = no
  isOrphan Int? @default(0) @map("is_orphan")

  fatherName       String? @map("father_name") @db.VarChar(200)
  fatherArabicName String? @map("father_arabic_name") @db.VarChar(200)
  fatherNid        String? @map("father_nid") @db.VarChar(50)
  fatherOccupation String? @map("father_occupation") @db.VarChar(150)

  motherName       String? @map("mother_name") @db.VarChar(200)
  motherNid        String? @map("mother_nid") @db.VarChar(50)
  motherOccupation String? @map("mother_occupation") @db.VarChar(150)

  guardianPhone  String? @map("guardian_phone") @db.VarChar(20)
  guardianPhone2 String? @map("guardian_phone_2") @db.VarChar(20)

  /// Set when the guardian on record is someone other than the father/mother
  /// (e.g. uncle, grandfather) - a distinct contact used for correspondence.
  altGuardianName     String? @map("alt_guardian_name") @db.VarChar(200)
  altGuardianRelation String? @map("alt_guardian_relation") @db.VarChar(100)
  altGuardianAddress  String? @map("alt_guardian_address") @db.VarChar(255)
  altGuardianPhone    String? @map("alt_guardian_phone") @db.VarChar(20)

  division String? @db.VarChar(100)
  district String? @db.VarChar(100)
  thana    String? @db.VarChar(100)
  village  String? @db.VarChar(150)

  image String?

  roll Int

  /// Permanent, per-madrasa admission/registration number. Assigned once at
  /// first admission (never changes on re-admission/promotion), unlike
  /// `roll` which changes every academic year. Distinct from `id`, which is
  /// an internal, tenant-agnostic primary key and should never be shown to
  /// users as a registration number.
  registrationNo Int @map("registration_no")

  admissionDate DateTime? @default(now()) @map("admission_date")

  /// Enrollment status while the record is NOT in Trash: 1 = সক্রিয় (active),
  /// 0 = বহিষ্কৃত (expelled). Distinct from `deletedAt` — an expelled student
  /// stays fully visible everywhere, just flagged, and is reversible.
  isActive  Int       @default(1) @map("is_active")
  deletedAt DateTime? @map("deleted_at")

  /// Admission approval workflow. Defaults to APPROVED so every existing
  /// admin-created admission keeps behaving exactly as before.
  admissionStatus AdmissionStatus @default(APPROVED) @map("admission_status")
  admissionType   AdmissionType   @default(NEW) @map("admission_type")
  rejectionReason String?         @map("rejection_reason") @db.VarChar(255)
  reviewedBy      Int?            @map("reviewed_by")
  reviewedAt      DateTime?       @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa       Madrasa  @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  divisionRef   Division @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  classRef      Class    @relation("StudentClass", fields: [classId], references: [id], onDelete: Restrict)
  previousClass Class?   @relation("StudentPreviousClass", fields: [previousClassId], references: [id], onDelete: SetNull)
  sessionRef    Session  @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  resultsSummary   ResultSummary[]
  marks            Mark[]
  promotionRecords PromotionRecord[]
  invoices         Invoice[]
  guardianLinks    GuardianStudent[]
  sessionHistories StudentSessionHistory[]

  @@unique([madrasaId, classId, sessionId, roll], map: "unique_roll_per_class_session")
  @@unique([madrasaId, registrationNo], map: "uniq_registration_no")
  @@index([madrasaId], map: "idx_students_madrasa")
  @@index([classId], map: "idx_students_class")
  @@index([guardianPhone], map: "idx_students_phone")
  @@index([gender], map: "idx_students_gender")
  @@index([madrasaId, classId], map: "idx_students_madrasa_class")
  @@index([madrasaId, isActive], map: "idx_students_madrasa_active")
  @@index([madrasaId, academicYear], map: "idx_students_madrasa_year")
  @@index([madrasaId, sessionId], map: "idx_students_madrasa_session")
  @@index([madrasaId, admissionStatus], map: "idx_students_madrasa_admission_status")
  @@map("students")
}
