// ============================================================
// ACADEMIC STRUCTURE
// Global catalog (Division/Class/Book/Grade) plus the join tables that
// let each tenant (Madrasa) activate a subset of that catalog.
// ============================================================

model Division {
  id        Int      @id @default(autoincrement())
  keyName   String?  @unique @map("key_name") @db.VarChar(50)
  name      String?  @db.VarChar(100)
  nameBn    String?  @map("name_bn") @db.VarChar(100)
  /// Which institution type this catalogue division belongs to - super admin
  /// only offers a new madrasa/school/college the divisions (and so classes/
  /// books) of its own type.
  institutionType InstitutionType @default(MADRASA) @map("institution_type")
  /// Global catalog order (Super Admin catalog UI drag-reorder). Distinct
  /// from MadrasaDivision.sortOrder, which is each tenant's own re-ordering
  /// of their activated subset.
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  madrasaDivisions MadrasaDivision[]
  classes          Class[]
  students         Student[]
  teachers         Teacher[]
  sessions         Session[]
  examCandidates   ExamCandidate[]
  examRoutines     ExamRoutine[]
  examDivisions    ExamDivision[]
  generalGrades    GeneralGrade[]
  madrasaGrades    MadrasaGrade[]
  planRegBlocks    PlanDivisionRegBlock[]

  @@map("divisions")
}

model MadrasaDivision {
  id         Int       @id @default(autoincrement())
  madrasaId  Int       @map("madrasa_id")
  divisionId Int       @map("division_id")
  isActive   Int?      @default(1) @map("is_active")
  /// Per-division fail mark override. NULL = follow the madrasa-wide
  /// Setting["fail_mark"]. When set, the division also owns its own
  /// GeneralGrade/MadrasaGrade rows (divisionId = this division) whose lowest
  /// band is auto-pinned to failMark (pass starts AT the fail mark).
  failMark   Int?      @map("fail_mark")
  /// This madrasa's own name for the division. NULL = the shared catalogue
  /// name (Division.nameBn). Renames write here so they never leak into
  /// other madrasas sharing the same Division row.
  nameBn     String?   @map("name_bn") @db.VarChar(100)
  sortOrder  Int       @default(0) @map("sort_order")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  madrasa  Madrasa  @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([madrasaId, divisionId], map: "uniq_madrasa_division")
  @@index([madrasaId, deletedAt], map: "idx_madrasa_divisions_deleted")
  @@map("madrasa_divisions")
}

model Class {
  id         Int      @id @default(autoincrement())
  divisionId Int?     @map("division_id")
  name       String?  @db.VarChar(100)
  nameBn     String?  @map("name_bn") @db.VarChar(100)
  isActive   Boolean  @default(true) @map("is_active")
  /// NULL = shared Super Admin catalogue row. Set = a private row that one
  /// madrasa created itself (তালিমাত সেটিংস > শ্রেণি যোগ); it is never shown in the catalogue or
  /// linked into any other madrasa.
  ownerMadrasaId Int?  @map("owner_madrasa_id")

  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  division             Division?             @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  books                Book[]
  madrasaClasses       MadrasaClass[]
  students             Student[]             @relation("StudentClass")
  studentsPrevious     Student[]             @relation("StudentPreviousClass")
  teacherAssignments   TeacherAssignment[]
  resultsMaster        ResultMaster[]
  marks                Mark[]
  attendances          Attendance[]
  classRoutines        ClassRoutine[]
  examRoutines         ExamRoutine[]
  feeStructures        FeeStructure[]
  defaultFeeStructures DefaultFeeStructure[]
  examCandidates       ExamCandidate[]

  @@unique([divisionId, name], map: "uniq_division_class")
  @@index([ownerMadrasaId], map: "idx_classes_owner")
  @@map("classes")
}

model Book {
  id        Int      @id @default(autoincrement())
  classId   Int      @map("class_id")
  name      String?  @db.VarChar(150)
  nameBn    String?  @map("name_bn") @db.VarChar(150)
  /// NULL = shared Super Admin catalogue row. Set = a private row that one
  /// madrasa created itself (added, or a copy-on-write rename of a catalogue book); it is never shown in the catalogue or
  /// linked into any other madrasa.
  ownerMadrasaId Int?  @map("owner_madrasa_id")
  /// Global catalog order (Super Admin catalog UI drag-reorder). Distinct
  /// from MadrasaBook.sortOrder, which is each tenant's own re-ordering.
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  class                Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  madrasaBooks         MadrasaBook[]
  teacherAssignments   TeacherAssignment[]
  marks                Mark[]
  markSubmissions      MarkSubmission[]
  markComponentConfigs MarkComponentConfig[]

  @@unique([classId, name], map: "uniq_class_book")
  @@index([ownerMadrasaId], map: "idx_books_owner")
  @@map("books")
}

model MadrasaClass {
  id        Int       @id @default(autoincrement())
  madrasaId Int       @map("madrasa_id")
  classId   Int       @map("class_id")
  isActive  Int?      @default(1) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  /// This madrasa's own name for the class. NULL = the shared catalogue name
  /// (Class.nameBn). Renames write here so they never leak into other
  /// madrasas sharing the same Class row.
  nameBn    String?   @map("name_bn") @db.VarChar(100)

  /// This class's block of student registration numbers (e.g. 1-50, the next
  /// class 51-100). Registration numbers stay unique madrasa-wide - the block
  /// only decides which number a newly approved/promoted student of this
  /// class gets (see allocateStudentRegistrationNoOnTx). Both null = no
  /// block, falls back to the madrasa's next number after every block.
  regNoStart      Int? @map("reg_no_start")
  regNoEnd        Int? @map("reg_no_end")
  /// Highest number ever handed out from this block, so a number freed by a
  /// promoted student (who moves to the next class's block) is never reused.
  regNoLastIssued Int? @map("reg_no_last_issued")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([madrasaId, classId], map: "uniq_madrasa_class")
  @@index([madrasaId, deletedAt], map: "idx_madrasa_classes_deleted")
  @@map("madrasa_classes")
}

model MadrasaBook {
  id        Int       @id @default(autoincrement())
  madrasaId Int       @map("madrasa_id")
  bookId    Int       @map("book_id")
  isActive  Int?      @default(1) @map("is_active")
  isMiyari  Boolean   @default(false) @map("is_miyari")
  fullMark  Int       @default(100) @map("full_mark")
  /// Per-subject pass mark override. When null, the madrasa's global
  /// fail-mark setting (Setting["fail_mark"]) applies to this subject as-is
  /// (not scaled by fullMark). Set this when a subject's fullMark differs
  /// from 100 and needs its own pass threshold — e.g. a 100-mark তেলাওয়াত
  /// subject passing at 50 while other 50-mark হেফজ subjects pass at 20.
  passMark  Int?      @map("pass_mark")
  /// School/college 4th (optional) subject: never fails the student and only
  /// the grade point above 2 is added to the GPA (Bangladesh board rule).
  isOptional Boolean  @default(false) @map("is_optional")
  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([madrasaId, bookId], map: "uniq_madrasa_book")
  @@index([madrasaId, isMiyari], map: "idx_madrasa_books_miyari")
  @@index([madrasaId, deletedAt], map: "idx_madrasa_books_deleted")
  @@map("madrasa_books")
}

model GeneralGrade {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(10)
  minMark   Int      @map("min_mark")
  maxMark   Int      @map("max_mark")
  point     Float?   @map("point")
  madrasaId Int      @default(1) @map("madrasa_id")
  /// NULL = madrasa-wide default scale. Set = this division's own scale (used
  /// instead of the default one whenever the division has any rows).
  divisionId Int?    @map("division_id")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa  Madrasa   @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  /// NULL divisionId rows are kept unique by a partial unique index created in
  /// the migration (Postgres treats NULLs as distinct in a plain unique index).
  @@unique([madrasaId, divisionId, name], map: "uniq_general_grade_madrasa")
  @@index([madrasaId, divisionId], map: "idx_general_grades_division")
  @@map("general_grades")
}

model MadrasaGrade {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  minMark   Int      @map("min_mark")
  maxMark   Int      @map("max_mark")
  point     Float?   @map("point")
  madrasaId Int      @default(1) @map("madrasa_id")
  /// NULL = madrasa-wide default scale. Set = this division's own scale (used
  /// instead of the default one whenever the division has any rows).
  divisionId Int?    @map("division_id")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa  Madrasa   @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  /// NULL divisionId rows are kept unique by a partial unique index created in
  /// the migration (Postgres treats NULLs as distinct in a plain unique index).
  @@unique([madrasaId, divisionId, name], map: "uniq_madrasa_grade_madrasa")
  @@index([madrasaId, divisionId], map: "idx_madrasa_grades_division")
  @@map("madrasa_grades")
}
