// ============================================================
// ACCOUNTS — income/expense ledger
// ============================================================

enum AccountType {
  income
  expense
}

model Account {
  id            Int          @id @default(autoincrement())
  madrasaId     Int?         @map("madrasa_id")
  type          AccountType?
  amount        Decimal?     @db.Decimal(10, 2)
  category      String?      @db.VarChar(100)
  description   String?      @db.VarChar(255)
  receiptNo     String?      @map("receipt_no") @db.VarChar(80)
  voucherNo     String?      @map("voucher_no") @db.VarChar(80)
  fund          String?      @db.VarChar(120)
  donorName     String?      @map("donor_name") @db.VarChar(200)
  receiverName  String?      @map("receiver_name") @db.VarChar(200)
  address       String?      @db.VarChar(255)
  mobile        String?      @db.VarChar(30)
  paymentMethod String?      @map("payment_method") @db.VarChar(80)
  note          String?      @db.VarChar(500)
  entryDate     DateTime?    @map("entry_date") @db.Date
  entryTime     DateTime?    @map("entry_time") @db.Time
  createdBy     Int?         @map("created_by")
  deletedAt     DateTime?    @map("deleted_at")
  hardDeletedAt DateTime?    @map("hard_deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa? @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@index([madrasaId, type], map: "idx_accounts_madrasa_type")
  @@index([fund], map: "idx_accounts_fund")
  @@index([entryDate], map: "idx_accounts_entry_date")
  @@index([madrasaId, deletedAt], map: "idx_accounts_madrasa_deleted")
  @@map("accounts")
}

/// A fund (income) or expense group/বিভাগ that a tenant's আয়/ব্যয় entries are
/// filed under, plus its child categories/খাত. `Account.fund`/`Account.category`
/// stay plain strings (a saved entry keeps the name it was filed under even if
/// this row is later renamed/deleted), so this table is only the picklist the
/// entry forms and this settings CRUD page read/write.
model AccountFund {
  id        Int         @id @default(autoincrement())
  madrasaId Int         @map("madrasa_id")
  type      AccountType
  name      String      @db.VarChar(120)
  sortOrder Int         @default(0) @map("sort_order")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")

  madrasa    Madrasa           @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  categories AccountCategory[]

  @@index([madrasaId, type], map: "idx_account_funds_madrasa_type")
  @@map("account_funds")
}

model AccountCategory {
  id        Int      @id @default(autoincrement())
  fundId    Int      @map("fund_id")
  name      String   @db.VarChar(120)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  fund AccountFund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId], map: "idx_account_categories_fund")
  @@map("account_categories")
}
