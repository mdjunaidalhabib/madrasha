// ============================================================
// STUDENT FEE MANAGEMENT
// ============================================================

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

/// A reusable fee definition (e.g. "মাসিক বেতন", "ভর্তি ফি") that invoices
/// get generated from. `classId` null means it applies to every class.
model FeeStructure {
  id           Int          @id @default(autoincrement())
  madrasaId    Int          @map("madrasa_id")
  classId      Int?         @map("class_id")
  name         String       @db.VarChar(150)
  amount       Decimal      @db.Decimal(10, 2)
  frequency    FeeFrequency
  /// The FeeCategory's *name* at the time this structure was created/last
  /// set, same "plain string, decoupled from the picklist" pattern as
  /// Account.fund/Account.category (see FeeCategory) - so renaming or
  /// deleting a category later never corrupts an existing structure.
  feeType      String       @default("অন্যান্য") @map("fee_type") @db.VarChar(120)
  /// Mirrored display string derived from `sessionRef.name` - see the same
  /// note on Student.academicYear.
  academicYear String       @map("academic_year") @db.VarChar(10)
  sessionId    Int          @map("session_id")
  isActive     Boolean      @default(true) @map("is_active")
  /// Ties this structure to one specific Exam (ExamPanel) instead of the
  /// whole session - only meaningful for a পরীক্ষার ফি. When set, this
  /// structure is excluded from the automatic admission-approval billing
  /// (see FeeService.buildAutoInvoiceRows/findActiveStructuresForBilling) so
  /// a newly-admitted student is never billed up front for exams that
  /// haven't happened yet. It's billed instead only when a staff member
  /// explicitly generates it (right after creating this structure, or via
  /// "বিদ্যমান সব ছাত্রের ফি আবার সেট করুন") - i.e. once the exam is actually
  /// upcoming, not at admission time. null keeps the old behaviour: a
  /// generic yearly fee billed in full at admission.
  examId       Int?         @map("exam_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")

  madrasa             Madrasa              @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  class               Class?               @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessionRef          Session              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  exam                Exam?                @relation(fields: [examId], references: [id], onDelete: SetNull)
  invoices            Invoice[]
  studentFeeDiscounts StudentFeeDiscount[]

  @@index([madrasaId, classId, academicYear], map: "idx_fee_structure_madrasa_class_year")
  @@index([madrasaId, classId, sessionId], map: "idx_fee_structure_madrasa_class_session")
  @@index([madrasaId, examId], map: "idx_fee_structure_madrasa_exam")
  @@map("fee_structures")
}

/// Per-tenant ফি ধরণ picklist that FeeStructure.feeType is set from - same
/// "plain string on the entry, this table is only the picklist" pattern as
/// AccountFund/AccountCategory (see accounts.prisma). `isAdmissionType`
/// replaces the old hardcoded FeeType.ADMISSION enum value: any category
/// flagged true here is what admitStudent() bills immediately at submission
/// time (see FeeService.autoGenerateInvoicesForStudent) - every other
/// category only gets billed once a Muhtamim approves the admission.
model FeeCategory {
  id              Int      @id @default(autoincrement())
  madrasaId       Int      @map("madrasa_id")
  name            String   @db.VarChar(120)
  isAdmissionType Boolean  @default(false) @map("is_admission_type")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@index([madrasaId], map: "idx_fee_categories_madrasa")
  @@map("fee_categories")
}

/// One billable charge for one student. Generated in bulk from a
/// FeeStructure (see FeeService.generateInvoices) or created ad-hoc.
model Invoice {
  id             Int           @id @default(autoincrement())
  madrasaId      Int           @map("madrasa_id")
  studentId      Int           @map("student_id")
  feeStructureId Int?          @map("fee_structure_id")
  title          String        @db.VarChar(150)
  amount         Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  dueDate        DateTime      @map("due_date") @db.Date
  status         InvoiceStatus @default(UNPAID)
  /// Populated only for MONTHLY fee invoices, e.g. "2026-08" — used to
  /// stop the same month's fee being generated twice for one student.
  month          String?       @db.VarChar(10)
  /// How much of `amount` a Muhtamim has forgiven (full or partial). Kept
  /// separate from paidAmount so reports can tell "collected" from
  /// "forgiven" even though both reduce the outstanding due.
  waivedAmount   Decimal       @default(0) @map("waived_amount") @db.Decimal(10, 2)
  waiveReason    String?       @map("waive_reason") @db.VarChar(300)
  waivedById     Int?          @map("waived_by")
  waivedAt       DateTime?     @map("waived_at")
  /// Set when হিসাব বিভাগ clicks "সব ক্লিয়ার করুন" on the "ভর্তি ফি পেন্ডিং"
  /// queue. Only hides this invoice from that queue - the invoice itself is
  /// untouched and still fully collectible from ছাত্র ফি গ্রহণ (see
  /// FeeRepository.findPendingInvoices).
  queueClearedAt DateTime?     @map("queue_cleared_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  madrasa      Madrasa       @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@unique([studentId, feeStructureId, month], map: "uniq_invoice_student_fee_month")
  @@index([madrasaId, studentId], map: "idx_invoice_madrasa_student")
  @@index([madrasaId, status], map: "idx_invoice_madrasa_status")
  @@map("invoices")
}

/// A single payment applied against an invoice. Multiple partial payments
/// can exist for one invoice; the invoice's `paidAmount`/`status` are kept
/// in sync by the service layer whenever a Payment is created.
model Payment {
  id              Int      @id @default(autoincrement())
  madrasaId       Int      @map("madrasa_id")
  invoiceId       Int      @map("invoice_id")
  amount          Decimal  @db.Decimal(10, 2)
  /// CASH / BKASH / NAGAD / BANK / ONLINE ...
  method          String   @db.VarChar(30)
  paidAt          DateTime @default(now()) @map("paid_at")
  receivedById    Int?     @map("received_by")
  /// Gateway transaction id, once Payment Gateway Integration lands.
  transactionRef  String?  @map("transaction_ref") @db.VarChar(120)
  /// Which admin-configured manual payment channel was used (e.g. "bKash -
  /// Personal: 017XXXXXXXX"), frozen at payment time so editing/deleting
  /// the setting later never changes historical payment records.
  methodSettingId Int?     @map("method_setting_id")
  methodLabel     String?  @map("method_label") @db.VarChar(150)
  /// Free-text note the office can attach to a payment (e.g. "আংশিক, বাকিটা
  /// পরের মাসে দেবে").
  note            String?  @db.VarChar(300)
  /// Links back to the auto-created ledger entry (see accounts module) so
  /// a fee payment always shows up in the existing income/expense report.
  accountEntryId  Int?     @map("account_entry_id")
  createdAt       DateTime @default(now()) @map("created_at")

  madrasa       Madrasa               @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  invoice       Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  methodSetting PaymentMethodSetting? @relation(fields: [methodSettingId], references: [id], onDelete: SetNull)

  @@index([madrasaId, invoiceId], map: "idx_payment_madrasa_invoice")
  @@map("payments")
}

/// A standing per-student discount against one FeeStructure, set by a
/// Muhtamim (typically while reviewing a pending admission - see
/// StudentService/FeeService previewStudentFees/setStudentFeeDiscount) so
/// the determined-fee list shown before approval can already reflect it,
/// and so it keeps applying automatically to every invoice generated for
/// that fee afterward - including future MONTHLY invoices from the daily
/// billing scheduler, not just whatever gets created at approval time.
model StudentFeeDiscount {
  id             Int @id @default(autoincrement())
  madrasaId      Int @map("madrasa_id")
  studentId      Int @map("student_id")
  feeStructureId Int @map("fee_structure_id")

  waivedAmount Decimal  @map("waived_amount") @db.Decimal(10, 2)
  reason       String   @db.VarChar(300)
  setById      Int?     @map("set_by_id")
  setAt        DateTime @default(now()) @map("set_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa      Madrasa      @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeStructureId], map: "uniq_student_fee_discount")
  @@index([madrasaId], map: "idx_student_fee_discount_madrasa")
  @@map("student_fee_discounts")
}

// ============================================================
// MANUAL PAYMENT METHOD SETUP (admin-configured, no payment gateway)
// ============================================================

/// One manual payment channel an admin has set up (e.g. a specific bKash
/// personal number, a bank account, or plain cash-in-hand) so guardians
/// know where to send money and admins can pick the right one when
/// recording a payment. There is intentionally no gateway/API behind
/// this - it is informational + a picklist for manual entry.
model PaymentMethodSetting {
  id            Int      @id @default(autoincrement())
  madrasaId     Int      @map("madrasa_id")
  /// CASH / BKASH / NAGAD / BANK / OTHER
  methodType    String   @db.VarChar(20)
  /// Short display name, e.g. "bKash (Personal)", "Sonali Bank - Main"
  label         String   @db.VarChar(150)
  accountName   String?  @map("account_name") @db.VarChar(150)
  accountNumber String?  @map("account_number") @db.VarChar(100)
  bankName      String?  @map("bank_name") @db.VarChar(150)
  branch        String?  @db.VarChar(150)
  /// Free-text instructions shown alongside this method, e.g. "Send Money
  /// only, then share the transaction ID with the office."
  instructions  String?  @db.VarChar(500)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  madrasa  Madrasa   @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([madrasaId, isActive], map: "idx_payment_method_madrasa_active")
  @@map("payment_method_settings")
}
