// ============================================================
// EXAMS
// ============================================================

/// Exam lifecycle. Adds a proper workflow state machine on top of the
/// pre-existing `isActive` (a simple show/hide toggle used everywhere the
/// exam list is displayed, kept as-is for backward compatibility) - the two
/// are independent: an exam can be `isActive = true` while its `status`
/// moves through the workflow below. Defaults to DRAFT so every
/// pre-existing exam row (migrated with this default) reads as "still being
/// set up", which is the safest interpretation for historical data.
///
/// DEPRECATED (2026-09-24): nothing ever gated on this and the UI/API for it
/// (খসড়া/প্রকাশিত) was removed - it read like result publishing, which lives
/// on ResultMaster.status. The column stays only to avoid a destructive
/// migration; an exam's lifecycle switch is `isActive` alone.
enum ExamStatus {
  DRAFT
  PUBLISHED
}

model Exam {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(100)
  year        String     @db.VarChar(20)
  /// Exam type/category (e.g. "সাময়িক", "বার্ষিক", "নির্বাচনী") - free text
  /// per-madrasa, same "plain string, no picklist table" pattern as
  /// FeeStructure.feeType so this never blocks on a missing catalog row.
  examType    String?    @map("exam_type") @db.VarChar(50)
  startDate   DateTime?  @map("start_date") @db.Date
  endDate     DateTime?  @map("end_date") @db.Date
  status      ExamStatus @default(DRAFT)
  description String?    @db.VarChar(500)
  isActive    Boolean    @default(true) @map("is_active")
  madrasaId   Int        @map("madrasa_id")
  /// Display order within a madrasa (প্রথম সাময়িক, দ্বিতীয় সাময়িক, বার্ষিক, ...),
  /// user-adjustable via the "move up/down" controls in Exam Management.
  /// Everywhere this list is shown (Exam Panel, Result Preview, ...) sorts
  /// by this instead of id/creation time.
  sortOrder   Int        @default(0) @map("sort_order")
  createdBy   Int?       @map("created_by")
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")

  madrasa        Madrasa         @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  resultsMaster  ResultMaster[]
  marks          Mark[]
  examRoutines   ExamRoutine[]
  /// পরীক্ষার ফি structures linked to this exam - see
  /// FeeStructure.examId for why a fee structure links to a specific exam
  /// instead of billing the whole session up front.
  feeStructures  FeeStructure[]
  examCandidates ExamCandidate[]
  markComponentConfigs MarkComponentConfig[]
  /// বিভাগভিত্তিক পরীক্ষা: which divisions this exam is held for. NO rows =
  /// "সকল বিভাগ" (every division) - which is also how every exam created
  /// before division scoping reads, so historical data needs no backfill.
  divisions      ExamDivision[]

  /// Name uniqueness is no longer a DB constraint: two divisions may each
  /// run their own "বার্ষিক পরীক্ষা" in the same year. ExamService enforces
  /// "same name + year only when the division scopes don't overlap".
  @@index([madrasaId, name, year], map: "idx_exam_madrasa_name_year")
  @@index([madrasaId, status], map: "idx_exam_madrasa_status")
  @@map("exams")
}

/// Exam <-> Division scope (see Exam.divisions). Composite PK, hard rows:
/// the set is replaced wholesale on every exam create/update.
model ExamDivision {
  examId     Int      @map("exam_id")
  divisionId Int      @map("division_id")
  createdAt  DateTime @default(now()) @map("created_at")

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@id([examId, divisionId])
  @@index([divisionId], map: "idx_exam_divisions_division")
  @@map("exam_divisions")
}
