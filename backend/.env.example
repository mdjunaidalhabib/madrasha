NODE_ENV=development
PORT=5190

# Database - either set DATABASE_URL directly, or the DB_* pieces below
# (used to build it when DATABASE_URL is unset).
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=madrasha
DATABASE_URL=postgresql://user:password@localhost:5432/madrasha

# Auth
JWT_SECRET=change-me-with-a-long-random-secret
# Access token lifetime (short-lived by design - see RefreshToken model).
JWT_EXPIRES_IN=15m
# How long a refresh token stays valid before a fresh login is required.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# 32-byte (64 hex char) key used to encrypt per-tenant secrets (currently
# just Cloudinary API secrets) at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=

# The client side is split into 4 independently-deployed apps at the repo
# root (see landing/, admin/, frontend/, super-admin/) - list every origin
# that will call this API. Dev ports: landing 5180, admin 5181,
# super-admin 5182, frontend 5183. The app literally named "frontend/"
# carries the public madrasa website, guardian portal, admission form, and
# attendance kiosk - everything under admin's old /:madrasaSlug/* routes
# except the staff-only print/reports pages.
CORS_ORIGINS=http://localhost:5180,http://localhost:5181,http://localhost:5182,http://localhost:5183
ROOT_DOMAIN=localhost
# Base URL for links this server builds into emails/SMS (password reset,
# etc.) and for the server-side PDF export (report-export.service.ts) to
# build the URL of the chrome-less print route it navigates a headless
# browser to. Login and print routes live in the "admin" app, so this must
# point there - NOTE the name is historical and does NOT mean the app
# literally named "frontend/"; it never did (this var predates that app).
FRONTEND_BASE_URL=http://localhost:5181
# Optional: only needed when backend/frontend run as sibling containers on
# the same internal Docker network (see env.ts for details).
INTERNAL_FRONTEND_URL=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
JSON_BODY_LIMIT=15mb
MAX_INLINE_IMAGE_LENGTH=3000000

SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me"

# ================= EMAIL (nodemailer / SMTP) =================
# All optional: when SMTP_HOST is unset, EmailService just logs
# "would have sent" instead of connecting anywhere.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Madrasa Management"
SMTP_FROM_EMAIL=

# ================= SMS (generic HTTP gateway) =================
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_HTTP_METHOD=GET
SMS_PARAM_API_KEY=api_key
SMS_PARAM_SENDER_ID=senderid
SMS_PARAM_NUMBER=number
SMS_PARAM_MESSAGE=message

# ================= FILE STORAGE (Cloudinary) =================
# Each tenant configures its own Cloudinary account via the super admin
# panel (stored encrypted in the DB) - these are unused leftovers from the
# old single-tenant setup, kept only for the upload folder name.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=madrasha
