NODE_ENV=development
PORT=5190

# Database - either set DATABASE_URL directly, or the DB_* pieces below
# (used to build it when DATABASE_URL is unset).
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=madrasha
DATABASE_URL=postgresql://user:password@localhost:5432/madrasha

# Auth
JWT_SECRET=change-me-with-a-long-random-secret
# Access token lifetime (short-lived by design - see RefreshToken model).
JWT_EXPIRES_IN=15m
# How long a refresh token stays valid before a fresh login is required.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# 32-byte (64 hex char) key used to encrypt per-tenant secrets (currently
# just Cloudinary API secrets) at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=

# The client side is split into 3 independently-deployed apps at the repo
# root (see admin/, frontend/, super-admin/) - list every origin that will
# call this API. Dev ports: admin 5181, super-admin 5182, frontend 5183. The
# app literally named "frontend/" carries the landing/marketing page plus
# everything a non-staff visitor of a madrasa hits (public website, guardian
# portal, admission form, attendance kiosk) - a tenant's own connected
# custom domain (Madrasa.customDomain) is allowed dynamically on top of this
# static list, see shared/config/customDomainCache.ts.
CORS_ORIGINS=http://localhost:5181,http://localhost:5182,http://localhost:5183
ROOT_DOMAIN=localhost
# PUBLIC URL of the ADMIN panel - used for links this server builds into
# emails/SMS (password reset, etc.). NOT the public "frontend/" website.
# (Old name FRONTEND_BASE_URL still works as a fallback, but is deprecated.)
ADMIN_BASE_URL=http://localhost:5181
# ADMIN panel URL used ONLY by the server-side PDF export (headless browser
# opens the print pages from here). Must be the ADMIN app (not the public
# "frontend" site). Set to its internal Docker hostname in production, e.g.
# http://madrasha-admin-internal. Empty = fall back to ADMIN_BASE_URL.
INTERNAL_ADMIN_URL=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
JSON_BODY_LIMIT=15mb
MAX_INLINE_IMAGE_LENGTH=3000000

SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me"

# ================= EMAIL (nodemailer / SMTP) =================
# All optional: when SMTP_HOST is unset, EmailService just logs
# "would have sent" instead of connecting anywhere.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Madrasa Management"
SMTP_FROM_EMAIL=

# ================= SMS (generic HTTP gateway) =================
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_HTTP_METHOD=GET
SMS_PARAM_API_KEY=api_key
SMS_PARAM_SENDER_ID=senderid
SMS_PARAM_NUMBER=number
SMS_PARAM_MESSAGE=message

# ================= FILE STORAGE (Cloudinary) =================
# Each tenant configures its own Cloudinary account via the super admin
# panel (stored encrypted in the DB) - these are unused leftovers from the
# old single-tenant setup, kept only for the upload folder name.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=madrasha

# ================= ATTENDANCE DEVICES (ZKTeco K40 via local Connector) =================
# 32-byte (64 hex char) key that encrypts each device's K40 comm password at
# rest (AES-256-GCM). REQUIRED to store/return a comm password. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_SECRET_ENC_KEY=
# IANA timezone that decides which calendar day a punch belongs to.
ATTENDANCE_TIMEZONE=Asia/Dhaka
# In-process worker sending queued attendance SMS (safe to run on several instances).
SMS_WORKER_ENABLED=true
SMS_WORKER_INTERVAL_MS=15000
SMS_WORKER_BATCH_SIZE=20
SMS_MAX_ATTEMPTS=5
SMS_BACKOFF_BASE_SECONDS=60
SMS_BACKOFF_MAX_SECONDS=3600
SMS_STALE_PROCESSING_SECONDS=300
SMS_MAX_AGE_HOURS=12
