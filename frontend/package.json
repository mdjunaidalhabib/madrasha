{
  "name": "madrasha-frontend",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:landing": "npm run dev --workspace=apps/landing",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:super-admin": "npm run dev --workspace=apps/super-admin",
    "build:landing": "npm run build --workspace=apps/landing",
    "build:admin": "npm run build --workspace=apps/admin",
    "build:super-admin": "npm run build --workspace=apps/super-admin",
    "build": "npm run build:landing && npm run build:admin && npm run build:super-admin"
  }
}
