diff --git a/admin/src/components/topbar/AppTopBar.tsx b/admin/src/components/topbar/AppTopBar.tsx
index 164f9f8..4f7e78b 100644
--- a/admin/src/components/topbar/AppTopBar.tsx
+++ b/admin/src/components/topbar/AppTopBar.tsx
@@ -1,26 +1,50 @@
 import GlobalBackButton from "@madrasha/shared-ui/src/navigation/GlobalBackButton";
 import GlobalRefreshButton from "@madrasha/shared-ui/src/navigation/GlobalRefreshButton";
 import { useIsStandalone } from "../../hooks/useIsStandalone";
+import { useWindowControlsOverlay } from "../../hooks/useWindowControlsOverlay";
 
 /**
- * Slim bar pinned at the very top of the INSTALLED app (YouTube-style):
- * Back on the left, Refresh on the right. An installed app has no browser
- * chrome, so these two buttons are its only navigation controls.
+ * Back + Refresh for the INSTALLED app only (a browser tab has its own).
  *
- * In a normal browser tab this renders nothing at all - the browser already has
- * its own Back / Reload, so the bar (and its buttons) must not exist there.
+ * Desktop installed app: the buttons live INSIDE the green title bar (Window
+ * Controls Overlay), on the left next to the app icon - no extra bar at all.
+ * The bar is draggable; only the buttons are clickable.
+ *
+ * Fallback (mobile installed app / browser without the overlay): a slim green
+ * bar at the very top, same look, so the buttons still have a home.
  */
 export default function AppTopBar() {
   const standalone = useIsStandalone();
+  const overlay = useWindowControlsOverlay();
   if (!standalone) return null;
 
+  // titlebar-area-* keep content clear of the OS window buttons (min/max/close).
+  const style = overlay
+    ? ({
+        height: "env(titlebar-area-height, 40px)",
+        paddingLeft: "max(env(titlebar-area-x, 0px), 8px)",
+        paddingRight: "calc(100vw - env(titlebar-area-x, 0px) - env(titlebar-area-width, 100vw) + 8px)",
+        WebkitAppRegion: "drag",
+        appRegion: "drag",
+      } as React.CSSProperties)
+    : ({
+        height: "40px",
+        paddingTop: "env(safe-area-inset-top, 0px)",
+        boxSizing: "content-box",
+      } as React.CSSProperties);
+
+  const noDrag = { WebkitAppRegion: "no-drag", appRegion: "no-drag" } as React.CSSProperties;
+
   return (
     <div
-      className="flex h-11 w-full shrink-0 items-center justify-between border-b border-slate-200 bg-white px-3 dark:border-slate-800 dark:bg-slate-900 print:hidden"
-      style={{ paddingTop: "env(safe-area-inset-top, 0px)", boxSizing: "content-box" }}
+      className="flex w-full shrink-0 select-none items-center gap-2 bg-emerald-600 px-3 text-white print:hidden"
+      style={style}
     >
-      <GlobalBackButton fallbackPath="/dashboard" size="sm" />
-      <GlobalRefreshButton size="sm" />
+      <div className="flex items-center gap-2" style={noDrag}>
+        <GlobalBackButton fallbackPath="/dashboard" size="sm" className="!border-white/30 !bg-white/15 !text-white hover:!bg-white/25" />
+        <GlobalRefreshButton size="sm" className="!border-white/30 !bg-white/15 !text-white hover:!bg-white/25" />
+      </div>
+      {overlay && <span className="truncate text-xs font-medium opacity-90">QMS Admin</span>}
     </div>
   );
 }
diff --git a/admin/src/hooks/useWindowControlsOverlay.ts b/admin/src/hooks/useWindowControlsOverlay.ts
new file mode 100644
index 0000000..9865be5
--- /dev/null
+++ b/admin/src/hooks/useWindowControlsOverlay.ts
@@ -0,0 +1,34 @@
+import { useEffect, useState } from "react";
+
+type WcoNavigator = Navigator & {
+  windowControlsOverlay?: {
+    visible: boolean;
+    addEventListener: (type: "geometrychange", cb: () => void) => void;
+    removeEventListener: (type: "geometrychange", cb: () => void) => void;
+  };
+};
+
+/**
+ * True when the installed desktop app is drawing its own content inside the
+ * title bar (Window Controls Overlay). In that mode the OS title bar is gone and
+ * our page must paint the green bar itself. False in a normal tab, on mobile, or
+ * when the user turned the overlay off from the title-bar toggle.
+ */
+export function useWindowControlsOverlay(): boolean {
+  const read = () => {
+    const wco = (navigator as WcoNavigator).windowControlsOverlay;
+    return !!wco?.visible;
+  };
+  const [visible, setVisible] = useState(read);
+
+  useEffect(() => {
+    const wco = (navigator as WcoNavigator).windowControlsOverlay;
+    if (!wco) return;
+    const update = () => setVisible(wco.visible);
+    update();
+    wco.addEventListener("geometrychange", update);
+    return () => wco.removeEventListener("geometrychange", update);
+  }, []);
+
+  return visible;
+}
