 admin/src/components/topbar/AppTopBar.tsx   | 42 ++++++++++++++++-----
 admin/src/hooks/useWindowControlsOverlay.ts | 34 +++++++++++++++++
 admin/src/utils/brandIcons.ts               |  1 +
 packages/shared-ui/src/pwa/pwa.ts           |  6 +++
 5 files changed, 75 insertions(+), 9 deletions(-)
 create mode 100644 admin/src/hooks/useWindowControlsOverlay.ts

